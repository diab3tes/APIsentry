PORT=5000
NODE_ENV=development
# SQLite file path (e.g. file:./data/api_monitor.db). Leave empty for an in-memory store.
# A mongodb:// URL is not supported by this build and falls back to the in-memory store.
DATABASE_URL=file:./data/api_monitor.db
# Optional; when empty the heuristic fallback generates the alert summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Max parallel outbound requests to the AI provider (1-10)
CONCURRENCY_LIMIT=5
# Anomaly threshold for response time
LATENCY_THRESHOLD_MS=3000
# Per-request timeout for Gemini calls
AI_TIMEOUT_MS=8000
CORS_ORIGIN=http://localhost:5173

# Optional email alerting (Ethereal test account is used when SMTP_HOST is empty)
EMAIL_ALERTS_ENABLED=false
ALERT_EMAIL_TO=oncall@example.com
ALERT_EMAIL_FROM=apisentry@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
